{
  "compilerOptions": {
    "baseUrl": ".",
    "inlineSourceMap": true,
    "inlineSources": true,
    "lib": [
      "DOM",
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noImplicitAny": true,
    "outDir": "dist",
    "strict": true,
    "target": "ES2022",
    "types": [
      "node"
    ],
    "useDefineForClassFields": false
  },
  "include": [
    "src/**/*.ts"
  ]
}

